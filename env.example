# Copie este arquivo para .env (só para rodar no seu computador) e preencha a chave.
# Nunca publique o .env no GitHub. No Render, a chave vai no painel, não em arquivo.
# Chave da NVIDIA: https://build.nvidia.com/
NVIDIA_API_KEY=

FLY_API_BASE_URL=https://integrate.api.nvidia.com/v1
FLY_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
FLY_MODEL_PRO=nvidia/nemotron-3-ultra-550b-a55b
PORT=3000

# Opcional: instruções/personalidade do Fly AI (padrão: assistente em português do Brasil)
# FLY_SYSTEM_PROMPT=Você é o Fly AI...

# Opcional: tempos limite em milissegundos
# Espera até o 1º dado do provedor (padrão 180000), silêncio no meio da resposta (90000) e teto total (300000)
# FLY_FIRST_BYTE_TIMEOUT_MS=180000
# FLY_IDLE_TIMEOUT_MS=90000
# FLY_TIMEOUT_MS=300000

# Opcional: máximo de mensagens por minuto por visitante (padrão: 20)
# FLY_RATE_LIMIT_PER_MIN=20

# Opcional: ler a chave de um arquivo local em vez do .env (esse arquivo também não vai pro GitHub)
# (se NVIDIA_API_KEY estiver vazia, o servidor também procura em NVIDIA_KEY_APi.env/NVIDIA_KEY_API.txt)
# NVIDIA_API_KEY_FILE=NVIDIA_KEY_APi.env/NVIDIA_KEY_API.txt
